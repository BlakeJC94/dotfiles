#!/usr/bin/env bash

# Set dircolors (ls colors)
if command -v dircolors >/dev/null; then
    eval "$(dircolors)"
fi


# Initialise tre
if command -v tre >/dev/null; then
    tre() { command tre "$@" -e && source "/tmp/tre_aliases_$USER" 2>/dev/null; }
fi

# Initialise z
if [ -f $(brew --prefix)/etc/profile.d/z.sh ] ; then
    source $(brew --prefix)/etc/profile.d/z.sh
fi

# Initialise mise
if command -v mise >/dev/null; then
    [ ! -z ${DOTFILES_DEBUG} ] && echo "Activating mise"
    eval "$(mise activate bash)"
fi

# Initialise Starship prompt
if command -v starship >/dev/null; then
    [ ! -z ${DOTFILES_DEBUG} ] && echo "Activating starship"
    eval "$(starship init bash)"
fi

# Initialise sk
if command -v sk >/dev/null; then
    [ ! -z ${DOTFILES_DEBUG} ] && echo "Activating sk"
    eval "$(sk --shell zsh --shell-bindings)"
fi


# Initialise direnv
if command -v direnv >/dev/null; then
    eval "$(direnv hook bash)"
fi

if command -v z >/dev/null; then
    source $(brew --prefix)/etc/profile.d/z.sh
fi

[ ! -z ${DOTFILES_DEBUG} ] && echo "Finished activations"
