{
  "name": "pi-file-snapshots",
  "version": "0.1.0",
  "description": "Git-free file-state checkpoints for the pi coding agent — revert the working tree to any earlier point in the conversation without the agent ever touching git.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "snapshots",
    "checkpoint",
    "revert",
    "undo"
  ],
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/earendil-works/pi-file-snapshots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi-file-snapshots.git"
  },
  "bugs": {
    "url": "https://github.com/earendil-works/pi-file-snapshots/issues"
  },
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist .tsbuildinfo"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
