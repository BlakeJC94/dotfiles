#!/usr/bin/env sh
# Add local bins to path
export PATH_LOCAL_BIN="${HOME}/.local/bin"
[[ ":$PATH:" != *":${PATH_LOCAL_BIN}:"* ]] && export PATH="${PATH_LOCAL_BIN}:${PATH}"

# Language environment
export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
export EDITOR='nvim'

# Force python to import stuff in wd
export PYTHONPATH=.

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"


export DARK_MODE=true
if [ "$(uname)" = "Darwin" ] && [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" != "Dark" ]; then
    export DARK_MODE=false
fi


# Git remote configs
export GITHUB_USER="blakejc94"
export GITLAB_USER="blakejc"

# LLM config location
export LLM_USER_PATH=$HOME/.config/llm/default

# FZF/Skim options
#
export FZF_DEFAULT_COMMAND="fd --hidden --exclude .git"
export SKIM_DEFAULT_COMMAND="fd --type file --hidden --no-ignore-parent --exclude .git"
if [ $DARK_MODE = true ]; then
    export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS'
      --color fg:#ebdbb2,bg:#1d2021,hl:#fabd2f,fg+:#ebdbb2,bg+:#3c3836,hl+:#fabd2f
      --color info:#83a598,prompt:#bdae93,spinner:#fabd2f,pointer:#83a598,marker:#fe8019,header:#665c54'
    export SKIM_DEFAULT_OPTIONS=$SKIM_DEFAULT_OPTIONS'
      --color fg:#ebdbb2,bg:#1d2021,hl:#fabd2f,fg+:#ebdbb2,bg+:#3c3836,hl+:#fabd2f
      --color info:#83a598,prompt:#bdae93,spinner:#fabd2f,pointer:#83a598,marker:#fe8019,header:#665c54'
else
    export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --color=bg+:#ebdbb2,bg:#fbf1c7,spinner:#689d6a,hl:#458588,fg:#7c6f64,header:#458588,info:#d79921,pointer:#689d6a,marker:#689d6a,fg+:#282828,prompt:#d79921,hl+:#458588"
    export SKIM_DEFAULT_OPTIONS="$SKIM_DEFAULT_OPTIONS --color=fg:#7c6f64,bg:#fbf1c7,matched:#458588,matched_bg:#fbf1c7,current:#282828,current_bg:#ebdbb2,current_match:#458588,current_match_bg:#ebdbb2,spinner:#689d6a,info:#d79921,prompt:#d79921,cursor:#689d6a,selected:#689d6a,header:#458588,border:#ebdbb2"
fi

# Brew opts
export HOMEBREW_NO_ENV_HINTS=1

# TeXmgr added config
# https://tex.stackexchange.com/questions/467824/is-it-possible-to-relocate-my-texmf-directory
export TEXMFHOME="${HOME}/.texmf"

# Use bat as manpager
export GROFF_NO_SGR=1
export MANPAGER="sh -c 'col -bx | bat -l man -p'"


# Soar
export PATH="$PATH:/home/blake/.local/bin:/home/blake/.local/share/soar/bin"

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

if [ -d /usr/local/cuda-13.2 ]; then
    export PATH=/usr/local/cuda-13.2/bin${PATH:+:${PATH}}
    export LD_LIBRARY_PATH=/usr/local/cuda-13.2/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
fi

export LLM_DEFAULT_TEMPLATE=default

