#!/usr/bin/env sh
# Add local bins to path
export PATH_LOCAL_BIN="${HOME}/.local/bin"
[[ ":$PATH:" != *":${PATH_LOCAL_BIN}:"* ]] && export PATH="${PATH_LOCAL_BIN}:${PATH}"

# Language environment
export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
export EDITOR='nvim'

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"

# Brew opts
export HOMEBREW_NO_ENV_HINTS=1
[ -f /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
[ -f /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
# Replace MacOS standard tools with Unix standard tools
if [ -f /opt/homebrew/bin/brew ] ; then
    export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
    export PATH="/opt/homebrew/opt/findutils/libexec/gnubin:$PATH"
    export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
    export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
fi

# Force python to import stuff in wd
export PYTHONPATH=.

# Git remote configs
export GITHUB_USER="blakejc94"
export GITLAB_USER="blakejc"

# LLM config
export LLM_USER_PATH=$HOME/.config/llm/default
export LLM_DEFAULT_TEMPLATE=default

# FZF/Skim options
export SKIM_DEFAULT_COMMAND="fd --type file --hidden --no-ignore-parent --exclude .git"
export SKIM_DEFAULT_OPTIONS=$SKIM_DEFAULT_OPTIONS'--color=none'

# TeXmgr added config
# https://tex.stackexchange.com/questions/467824/is-it-possible-to-relocate-my-texmf-directory
export TEXMFHOME="${HOME}/.texmf"

# Use bat as manpager
export GROFF_NO_SGR=1
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Soar
export PATH="$PATH:/home/blake/.local/bin:/home/blake/.local/share/soar/bin"

# Ripgrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# CUDA
if [ -d /usr/local/cuda-13.2 ]; then
    export PATH=/usr/local/cuda-13.2/bin${PATH:+:${PATH}}
    export LD_LIBRARY_PATH=/usr/local/cuda-13.2/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
fi

