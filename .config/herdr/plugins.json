    "manifest_path": "/Users/blake/.config/herdr/plugins/tab-status/herdr-plugin.toml",
    "plugin_root": "/Users/blake/.config/herdr/plugins/tab-status",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "startup": [
      {
