          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/tab-status.sh\""
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/tab-status.sh\""
        ]
      },
      {
        "on": "pane.agent_status_changed",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/tab-status.sh\""
        ]
      },
      {
        "on": "pane.exited",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/tab-status.sh\""
        ]
      },
      {
        "on": "pane.focused",
