#!/bin/sh

slug() {
    printf '%s' "$1" |
        tr '[:upper:]' '[:lower:]' |
        sed -E 's/[^a-zA-Z0-9-]+/-/g; s/^-+//; s/-+$//'
}

branch=$(slug "$(git rev-parse --abbrev-ref HEAD)")

main_worktree=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
base_branch=$(
    git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null |
        sed 's#^origin/##'
)

[ -n "$base_branch" ] || base_branch=$(git -C "$main_worktree" branch --show-current)
base_branch=$(slug "$base_branch")

path="$main_worktree/.tmp/$branch"
mkdir -p "$path"

justfile="$path/justfile"
base_justfile="$main_worktree/.tmp/$base_branch/justfile"

if [ ! -f "$justfile" ]; then
    if [ "$branch" != "$base_branch" ]; then
        printf 'import "%s"\n' "$base_justfile" > "$justfile"
    else
        : > "$justfile"
    fi
    $EDITOR "$justfile"
elif [ "$#" -eq 0 ]; then
    $EDITOR "$justfile"
else
    just -d . -f "$justfile" "$@"
fi

