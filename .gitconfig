[user]
    name = BlakeJC94
    email = blakejamescook@pm.me
    username = BlakeJC94

[alias]
    conf = "!f() { $EDITOR ~/.gitconfig ;  }; f"
    ; Shorthand for common ops
    st = "!git status -sb"
    dif = "!git diff --stat"
    b = "!git checkout -"
    ls = "!f() { git branch -l | tr ' ' '\\n' | grep -v '^$' ; }; f"
    bmv = "!git branch -M"
    brm = "!git branch -D"
    ad = "!git add -u"
    cm = "!git commit -m"
    cmf = "!nvim -c 'Git commit | wincmd o'"
    ca = "!git commit --amend"
    ce = "!git commit --amend --no-edit"
    a = "!~/.gitalias/a"
    cma = "!~/.gitalias/cma"
    cma-a = "!~/.gitalias/cma --amend"
    cma-e = "!~/.gitalias/cma --no-edit"
    cmap = "!f() { git cma \"$@\" && git push; }; f"
    sync = "!git cmap \"sync: $(whoami)@$(hostname) $(date '+%Y-%m-%d %H:%M:%S')\""
    lg = "!f() { if [ $# -eq 0 ]; then git log --oneline -n 8; else git log --oneline \"$@\"; fi }; f"
    lgs = "!f() { if [ $# -eq 0 ]; then git log --name-status --oneline -n 8; else git log --name-status --oneline \"$@\"; fi }; f"
    last = log -1 HEAD --stat
    hist = log --graph --color=auto --abbrev-commit --pretty=concise
    ; get = "!f() { git restore --source \"${1}\" -- \"${@:2}\"; }; f"
    get = "!f() { git restore --source \"${1}\" \"${@:2}\"; }; f"
    ; Update staged changes
    diff-branch = "!git diff $(git merge-base master HEAD)..HEAD"
    unstage = reset HEAD --
    forget = "!f() { [ \"$#\" -eq 0 ] && git reset --hard HEAD || git restore --source=HEAD --staged --worktree -- \"$@\"; }; f"
    ; Remote integrations
    hub = "!NO_COLOR=true gh"
    hub-prs = "!gh pr list -S \"author:$GITHUB_USER\" --json 'headRefName,url' | jq -r '.[] | \"* [\\(.headRefName)](\\(.url))\"'"
    hub-reviews = "!gh pr list -S \"user-review-requested:@$GITHUB_USER\" --json 'headRefName,url' | jq -r '.[] | \"* [\\(.headRefName)](\\(.url))\"'"
    lab = "!NO_COLOR=true glab"
    lab-remote = "!~/.gitalias/lab-remote"
    lab-mirror = "!~/.gitalias/lab-mirror"
    prime = "!git symbolic-ref --short refs/remotes/origin/HEAD | sed 's#^origin/##'"
    ; Ignore file actions
    ignore-template = "!~/.gitalias/ignore-template"
    ignore = "!~/.gitalias/ignore"
    exclude = "!~/.gitalias/exclude"
    ; Select branch
    g = "!git checkout $(git branch --format '%(refname:short)' | sk)"
    ; Generate keys
    key = "!~/.gitalias/key"
    ; Dotfiles shortcut with safeties
    dotfiles = "!~/.gitalias/dotfiles"
    ; Run branch justfile
    just = "!~/.gitalias/just"
    ; Set upstream branch
    up = "!~/.gitalias/up"
    ; Clone and setup worktrees
    clonetree = "!~/.gitalias/clonetree"
    ; TODO Turn this into an llm-cli template
    ; diffwhat = "!f() { local diff_out=$(git diff \"@\") || return; echo \"$diff_out\" | llm 'Summarise this git diff into a few sentences or dot points'; }; f"
    ; TODO maintain


[color]
    ui = auto

[pretty]
    concise = "%C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr)%C(bold blue) <%an>%C(reset)"

[core]
    editor = "nvim"
    fsmonitor = true
    untrackedcache = true

[credential]
    helper = cache --timeout=3600

[diff]
    colorMoved = plain
    algorithm = histogram
    mnemonicPrefix = true
    renames = true
    tool = fugitive

[mergetool]
    prompt = true

[pull]
    rebase = false

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[commit]
    verbose = true

[help]
    autocorrect = prompt

[init]
    defaultBranch = main

[branch]
    sort = -committerdate

[column]
    ui = auto

[tag]
    sort = version:refname

[push]
	default = current
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true
    pruneTags = true
    all = true
    parallel = 0

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[merge]
    squash = true
[difftool]
    prompt = false

[difftool "fugitive"]
    cmd = "nvim -f -c \"Gdiffsplit!\" \"$LOCAL\" \"$REMOTE\""

[difftool "vimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\""


[delta]
    line-numbers = true
    side-by-side = true
    syntax-theme = gruvbox-dark
    minus-style                   = normal "#792329"
    minus-non-emph-style          = normal "#792329"
    minus-emph-style              = normal "#9d0006"
    minus-empty-line-marker-style = normal "#792329"
    zero-style                    = syntax
    plus-style                    = syntax "#5a633a"
    plus-non-emph-style           = syntax "#5a633a"
    plus-emph-style               = syntax "#79740e"
    plus-empty-line-marker-style  = normal "#5a633a"
    line-numbers-minus-style      = "#792329"
    line-numbers-zero-style       = "#444444"
    line-numbers-plus-style       = "#5a633a"
    line-numbers-left-style       = "#076678"
    line-numbers-right-style      = "#076678"

[feature]
    manyFiles = true

[commitGraph]
    generationVersion = 2

[maintenance]
    auto = true

; https://www.git-tower.com/blog/git-performance/
